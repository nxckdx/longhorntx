# Shared settings for the README GIFs (all use the built-in --demo cluster,
# no real cluster involved). Record all: docs/tapes/record.sh
Set Shell "bash"
Set FontFamily "FiraCode Nerd Font Mono"
Set FontSize 15
Set Width 1480
Set Padding 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 70ms
Set Framerate 15

Hide
Type "export PATH=$PWD:$PATH KUBECONFIG=/dev/null LHTX_CONFIG=/dev/null LHTX_NO_UPDATE_CHECK=1 PS1='$ '" Enter
Type "clear" Enter
Show
